          "index": 3
        },
        "placement": "before"
      },
      "text": "    // 使用简单的写法初始化字段，并创建结构体\n    let name = String::from(\"Peter\");\n    let age = 27;\n    let peter = Person { name, age };\n\n    // 以 Debug 方式打印结构体\n    println!(\"{:?}\", peter);\n\n",
      "narration": {
        "during": {
          "asset_id": "narration_ch3_custom_types_structs_003_structs_use",
          "clips": [
            {
              "offset_ms": 13000,
              "duration_ms": 6773,
              "caption": "main 里用<c.aqua>字段</c.aqua>名与<c.aqua>变量</c.aqua>同名的简写构造 Person，再用 Debug <c.aqua>打印</c.aqua>整个结构体的字段。"
            }
          ]
        }
      }
    },
    {
      "type": "InsertText",
      "path": "structs.rs",
      "speed_ms": 40,
      "target": {
        "at": {
          "text": "}",
          "index": 5
        },
        "placement": "before"
      },
      "text": "    // 实例化结构体 `Point`\n    let point: Point = Point { x: 10.3, y: 0.4 };\n\n    // 访问 point 的字段\n    println!(\"point coordinates: ({}, {})\", point.x, point.y);\n\n",
      "narration": {
        "during": {
          "asset_id": "narration_ch3_custom_types_structs_003_structs_use",
          "clips": [
            {
              "offset_ms": 20000,
              "duration_ms": 4703,
              "caption": "Point <c.aqua>实例</c.aqua>化之后，用点号访问<c.aqua>字段</c.aqua>，读出两个坐标分量。"
            }
          ]
        }
      }
    },
    {
      "type": "InsertText",
      "path": "structs.rs",
      "speed_ms": 40,
      "target": {
        "at": {
          "text": "}",
          "index": 8
        },
        "placement": "before"
      },
      "text": "    // 使用结构体更新语法创建新的 point，\n    // 这样可以用到之前的 point 的字段\n    let bottom_right = Point { x: 5.2, ..point };\n\n    // `bottom_right.y` 与 `point.y` 一样，因为这个字段就是从 `point` 中来的\n    println!(\"second point: ({}, {})\", bottom_right.x, bottom_right.y);\n\n    // 使用 `let` 绑定来解构 point\n    let Point { x: left_edge, y: top_edge } = point;\n\n",
      "narration": {
        "during": {
          "asset_id": "narration_ch3_custom_types_structs_003_structs_use",
          "clips": [
            {
              "offset_ms": 25000,
              "duration_ms": 7863,
              "caption": "更新语法只写要改的字段，其余用 ..point 从旧值搬过来；let 配合模式把字段<c.aqua>解构</c.aqua>成两个变量。"
            }
          ]
        }
      }
    },
    {
      "type": "InsertText",
      "path": "structs.rs",
      "speed_ms": 40,
      "target": {
        "at": {
          "text": "}",
          "index": 12
        },
        "placement": "before"
      },
      "text": "    let _rectangle = Rectangle {\n        // 结构体的实例化也是一个表达式\n        top_left: Point { x: left_edge, y: top_edge },\n        bottom_right: bottom_right,\n    };\n\n    // 实例化一个单元结构体\n    let _unit = Unit;\n\n    // 实例化一个元组结构体\n    let pair = Pair(1, 0.1);\n\n    // 访问元组结构体的字段\n    println!(\"pair contains {:?} and {:?}\", pair.0, pair.1);\n\n    // 解构一个元组结构体\n    let Pair(integer, decimal) = pair;\n\n    println!(\"pair contains {:?} and {:?}\", integer, decimal);\n",
      "narration": {
        "before": {
          "asset_id": "narration_ch3_custom_types_structs_003_structs_use",
          "clips": [
            {
              "offset_ms": 33000,
