    },
    {
      "type": "JupyterLabCellInsertText",
      "path": "lesson.ipynb",
      "cell_id": "cynapse_sec2_setup",
      "target": {
        "kind": "end_of_file"
      },
      "text": "import numpy as np\nimport matplotlib.pyplot as plt\n\n",
      "speed_ms": 28
    },
    {
      "type": "JupyterLabCellInsertText",
      "path": "lesson.ipynb",
      "cell_id": "cynapse_sec2_setup",
      "target": {
        "kind": "end_of_file"
      },
      "text": "fs = 100  # 采样率：每秒 100 个样本\nduration = 1.0  # 信号持续 1 秒\nt = np.arange(0, duration, 1 / fs)  # 生成 0 到 1 秒的采样时间点\n\n",
      "speed_ms": 28,
      "narration": {
        "during": {
          "asset_id": "narration_sec2_generate_signal",
          "clips": [
            {
              "offset_ms": 60000,
              "duration_ms": 4288,
              "caption": "先建立<c.aqua>采样时间</c.aqua>轴：每秒 100 个<c.aqua>样本</c.aqua>，持续 1 秒。",
              "speech_edits": [
                {
                  "i": 3,
                  "s": "采",
                  "p": "CAI3"
                },
                {
                  "i": 7,
                  "s": "轴",
                  "p": "ZHOU2"
                }
              ]
            }
          ]
        }
      }
    },
    {
      "type": "JupyterLabCellInsertText",
      "path": "lesson.ipynb",
      "cell_id": "cynapse_sec2_setup",
      "target": {
        "kind": "end_of_file"
      },
      "text": "A = 1.0  # 振幅 A 控制波形高低\nf = 2.0  # 频率 f 控制每秒的周期数\nphi = 0.0  # 初相位 phi 控制起点位置\nx = A * np.sin(2 * np.pi * f * t + phi)  # 正弦公式：A·sin(2πft+φ)\n\n",
      "speed_ms": 28,
      "narration": {
